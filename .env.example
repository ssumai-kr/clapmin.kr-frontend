# YouTube Video ID
# Get the video ID from YouTube URL: https://www.youtube.com/watch?v=VIDEO_ID
# Example: QwByM5-vwlM
VITE_YOUTUBE_VIDEO_ID=QwByM5-vwlM

# GitHub Personal Access Token (only read:user scope needed)
# Generate at https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your_github_token_here

# Backend API base URL
# 이 값은 보통 여기(.env)가 아니라 .env.development / .env.production에서 관리됩니다.
# (vite가 dev/build 모드에 따라 자동으로 골라 .env 위에 덮어씀)
# VITE_API_URL=http://localhost:8000

# Anthropic API key — AI 어시스턴트(/api/chat) 서버 함수 전용.
# ⚠️ 절대 VITE_ 접두사를 붙이지 마세요 (붙이면 클라이언트 번들에 노출됩니다).
# 로컬은 `vercel dev`가 .env에서 읽고, 배포는 Vercel 대시보드 환경변수에 등록합니다.
ANTHROPIC_API_KEY=sk-ant-...
